CLAUDE = shutil.which("claude") or "/usr/bin/claude"

EAFN_STATE = os.path.expanduser("~/h2home/state/eafieldnotes-pulse-history.json")
EAFN_CONFIG = os.path.expanduser("~/h2home/state/eafieldnotes-pulse-config.json")
JAKT_STATE = os.path.expanduser("~/h2home/state/jaktformidling-pulse-history.json")
JAKT_CONFIG = os.path.expanduser("~/h2home/state/jaktformidling-pulse-config.json")

ACCT = "da055fad4fb0133aaa39c38c0e9f4721"
DBID = "5f05b0b5-f467-48a5-b5dc-04afa572731f"
CF_SECRETS = "/home/ubuntu/.config/eafieldnotes/cloudflare.env"


def _read_yaml_field(key):
    try:
        with open(H2_CONFIG) as f:
            for line in f:
                if key in line:
                    return line.split(":", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


from telegram_env import h2_send_telegram, html_esc


def tg_send(msg):
    # tg1.3: route through the h2 bridge (the choke point applies the HTML
    # default and mirrors to concierge). Not a recovery script. The report
    # emits <b> headers; all dynamic values (UA samples, Claude output, error
    # strings) are html_esc'd at interpolation so they can't break the markup.
    h2_send_telegram(msg)


def cf_token():
    with open(CF_SECRETS) as f:
        for line in f:
            line = line.strip()
            if line.startswith("export "):
                line = line[7:]
            if line.startswith("CLOUDFLARE_API_TOKEN="):
                return line.split("=", 1)[1].strip().strip('"')
    raise RuntimeError("no CLOUDFLARE_API_TOKEN")


def d1(token, sql):
    req = urllib.request.Request(
        f"https://api.cloudflare.com/client/v4/accounts/{ACCT}/d1/database/{DBID}/query",
        data=json.dumps({"sql": sql}).encode(),
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)["result"][0]["results"]


def load_json(path):
    try:
        return json.loads(open(path).read())
    except (OSError, json.JSONDecodeError):
        return None


def save_json(path, data):
    open(path, "w").write(json.dumps(data, indent=2, ensure_ascii=False))


def claude_env():
    """
    Run as the subscription owner rather than whatever login is cached.
    A cached login expires and needs a browser to renew, which a cron job
    cannot do — the failure looks like a report that simply never arrives.
    """
    env = dict(os.environ)
    token = os.path.expanduser("~/.config/claude-code-token")
    if os.path.isfile(token):
        with open(token) as fh:
            env["CLAUDE_CODE_OAUTH_TOKEN"] = fh.read().strip()
    return env


def ask_claude(prompt):
    result = subprocess.run(
        [CLAUDE, "--print", "--dangerously-skip-permissions",
         "--model", "claude-sonnet-4-6", prompt],
        capture_output=True, text=True, timeout=180, env=claude_env(),
    )
    return result.stdout.strip()


# ── Step 1: Detect new bot UA patterns from D1 ──────────────────────────────

def detect_new_bots(token, existing_patterns):
    """
    Find UAs that appear in bursts (>5 clicks in a single hour) or that
    look like non-browsers (no 'Mozilla' prefix). These are candidates for
    the bot filter that aren't caught by existing patterns.
    """
    # Get top UAs by volume that aren't already filtered
    existing_sql_clauses = " AND ".join(
        f"ua NOT LIKE '%{p}%'" for p in existing_patterns
    )
    rows = d1(token, (
        f"SELECT ua, COUNT(*) n, "
        f"MAX(strftime('%Y-%m-%d %H', ts)) last_hr, "
        f"COUNT(DISTINCT strftime('%Y-%m-%d %H', ts)) distinct_hours "
        f"FROM clicks "
        f"WHERE ts >= datetime('now','-28 days') "
        f"AND ua IS NOT NULL AND ua != '' "
        f"AND {existing_sql_clauses} "
        f"GROUP BY ua HAVING n >= 5 ORDER BY n DESC LIMIT 30"
    ))

    new_patterns = []
    for row in rows:
        ua = row["ua"] or ""
        n = row["n"]
        distinct_hours = row["distinct_hours"]

        # Heuristic: bot if clicks-per-distinct-hour > 8, or UA doesn't start with Mozilla
        clicks_per_hour = n / max(distinct_hours, 1)
        is_non_browser = not ua.startswith("Mozilla")
        is_burst = clicks_per_hour > 8

        if is_non_browser or is_burst:
            # Extract a usable pattern from the UA (first distinctive token)
            # Strip common prefixes, take first 30 chars
            pattern = ua[:40].split("/")[0].strip()
            if pattern and pattern not in existing_patterns and len(pattern) > 3:
                new_patterns.append((pattern, n, ua[:100]))

    return new_patterns


# ── Step 2: Recalibrate conversion estimate ──────────────────────────────────

def recalibrate_conversion(history, current_estimate):
    """
    If any history snapshot has 'actual_sales' set (manually entered after
    Amazon reports a sale), recalculate clicks-per-sale from real data.
    Returns (new_estimate, note) or (current_estimate, None).
    """
    data_points = [(h["total_clicks"], h["actual_sales"]) for h in history
                   if h.get("actual_sales") is not None and h.get("total_clicks", 0) > 0]

    if len(data_points) < 2:
        return current_estimate, None

    # Use latest data point with sales
    latest = max(data_points, key=lambda x: x[0])
    clicks, sales = latest
    if sales == 0:
        return current_estimate, None

    new_estimate = round(clicks / sales)
    note = f"Kalibrert fra faktiske data: {clicks} klikk ga {sales} salg = {new_estimate} klikk/salg (var {current_estimate})"
    return new_estimate, note


# ── Step 3: Stage logic review via Claude ───────────────────────────────────

def review_stage_logic(project, history, current_config):
    if not history or len(history) < 3:
        return None, "For lite historikk for stage-review (trenger 3+ uker)"

    history_summary = "\n".join(
        f"Uke {i+1} ({h['ts'][:10]}): " + ", ".join(f"{k}={v}" for k, v in h.items() if k != "ts")
        for i, h in enumerate(history[-12:])
    )

    current_stages = json.dumps(current_config.get("stage_thresholds", {}), indent=2, ensure_ascii=False)
    current_prompts = json.dumps(current_config.get("stage_prompts", {}), indent=2, ensure_ascii=False)

    project_context = {
        "eafieldnotes": "EA bok-affiliate-nettsted. Mål: 3 Amazon-salg innen 4. des 2026. Trafikk er flaskehalsen.",
        "jaktformidling": "Norsk jaktmarked i cold-start. Mål: første organiske henvendelse, så konsistent vekst.",
    }.get(project, project)

    prompt = (
        f"Du er en vekststrateg som analyserer ukentlig metrikk for {project} ({project_context}).\n\n"
        f"HISTORIKK (siste 12 uker):\n{history_summary}\n\n"
        f"NÅVÆRENDE STAGE-TERSKLER:\n{current_stages}\n\n"
        f"NÅVÆRENDE STAGE-BESKRIVELSER:\n{current_prompts}\n\n"
        f"Spørsmål:\n"
        f"1. Er stage-tersklene fortsatt riktige gitt faktisk historikk? "
        f"   Begrunn kort.\n"
        f"2. Er det noe vi IKKE måler som vi burde følge opp? "
        f"   (f.eks. en ny indikator som ville gi bedre signal)\n"
        f"3. Er noen av stage-beskrivelsene (coaching-teksten) utdatert eller feil gitt det vi har sett?\n\n"
        f"Svar i JSON-format:\n"
        f"{{\n"
        f'  "thresholds_ok": true/false,\n'
        f'  "threshold_changes": {{}},\n'
        f'  "missing_metrics": ["..."],\n'
        f'  "prompt_updates": {{}},\n'
        f'  "summary": "kort norsk oppsummering av hva som ble endret og hvorfor"\n'
        f"}}\n"
        f"Returner KUN gyldig JSON, ingen innledning."
    )

    raw = ask_claude(prompt)

    # Extract JSON from response
    match = re.search(r'\{.*\}', raw, re.DOTALL)
    if not match:
        return None, f"Claude returnerte ikke JSON: {raw[:200]}"

    try:
        result = json.loads(match.group(0))
        return result, None
    except json.JSONDecodeError as e:
        return None, f"JSON-parse feil: {e}"


# ── Main ─────────────────────────────────────────────────────────────────────

def run_project(project, state_path, config_path, token=None):
    changes = []
    history = load_json(state_path) or []
    config = load_json(config_path) or {}

    # Step 1: bot detection (eafieldnotes only)
    if project == "eafieldnotes" and token:
        existing = config.get("bot_ua_patterns", [])
        try:
            new_bots = detect_new_bots(token, existing)
            if new_bots:
                added = []
                for pattern, count, ua_sample in new_bots:
                    if pattern not in existing:
                        existing.append(pattern)
                        added.append(f"{html_esc(pattern)} ({count} klikk, eks: {html_esc(ua_sample[:60])})")
                if added:
                    config["bot_ua_patterns"] = existing
                    changes.append(f"Bot-filter utvidet med {len(added)} nye mønstre:\n" + "\n".join(f"  + {a}" for a in added))
        except Exception as e:
            changes.append(f"Bot-deteksjon feilet: {html_esc(e)}")

    # Step 2: conversion recalibration (eafieldnotes only)
    if project == "eafieldnotes":
        current_est = config.get("clicks_per_sale_estimate", 150)
        new_est, note = recalibrate_conversion(history, current_est)
        if note:
            config["clicks_per_sale_estimate"] = new_est
            changes.append(note)

    # Step 3: stage logic review (all projects)
    if history:
        review, err = review_stage_logic(project, history, config)
        if err:
            changes.append(f"Stage-review feilet: {html_esc(err)}")
        elif review:
            summary = review.get("summary", "")
            threshold_changes = review.get("threshold_changes", {})
            prompt_updates = review.get("prompt_updates", {})

            if threshold_changes:
                config.setdefault("stage_thresholds", {}).update(threshold_changes)
                changes.append(f"Terskler oppdatert: {html_esc(threshold_changes)}")
            if prompt_updates:
                config.setdefault("stage_prompts", {}).update(prompt_updates)
                changes.append(f"Stage-beskrivelser oppdatert")
            if not threshold_changes and not prompt_updates:
                changes.append(f"Stage-logikk OK, ingen endringer. Claude: {html_esc(summary)}")
            else:
                changes.append(f"Begrunnelse: {html_esc(summary)}")

            missing = review.get("missing_metrics", [])
            if missing:
                config.setdefault("meta_notes_missing_metrics", [])
                config["meta_notes_missing_metrics"] = missing
                changes.append(f"Manglende metrics å vurdere: {html_esc(', '.join(missing))}")

    if changes:
        config["updated_at"] = datetime.now(timezone.utc).isoformat()
        config["updated_by"] = "pulse-meta-agent"
        save_json(config_path, config)

    return changes


def main():
    dry_run = "--dry-run" in sys.argv
    now = datetime.now(timezone.utc).isoformat()
    report_lines = [f"<b>Månedlig pulse-kalibrering</b> ({now[:10]})\n"]

    token = None
    try:
        token = cf_token()
    except Exception:
        pass

    for project, state_path, config_path in [
        ("eafieldnotes", EAFN_STATE, EAFN_CONFIG),
        ("jaktformidling", JAKT_STATE, JAKT_CONFIG),
    ]:
        try:
            if dry_run:
                history = load_json(state_path) or []
                config = load_json(config_path) or {}
                print(f"\n=== {project} ===")
                print(f"History snapshots: {len(history)}")
                print(f"Config: {json.dumps(config, indent=2, ensure_ascii=False)}")
                continue

            changes = run_project(project, state_path, config_path, token if project == "eafieldnotes" else None)
            if changes:
                report_lines.append(f"<b>{project}:</b>")
                report_lines.extend(f"  - {c}" for c in changes)
            else:
                report_lines.append(f"<b>{project}:</b> Ingen endringer.")
        except Exception as e:
            report_lines.append(f"<b>{project}:</b> Feil: {html_esc(e)}")

    if not dry_run:
        tg_send("\n".join(report_lines))
    else:
        print("\n=== DRY RUN - ville sendt til Telegram ===")
        print("\n".join(report_lines))


if __name__ == "__main__":
    main()
