#!/usr/bin/env python3
"""
pulse-meta-agent

Monthly self-calibration agent for both weekly pulse scripts. Runs every
4 weeks and does three things:

1. BOT DETECTION UPDATE: scans D1 click logs for new suspicious UA patterns
   (burst traffic, non-browser UAs) and adds them to the eafieldnotes config.

2. CONVERSION RECALIBRATION (eafieldnotes): if Amazon sale data is available
   in the state history (set manually after sales), recalculates the
   clicks-per-sale estimate from actual data.

3. STAGE LOGIC REVIEW: sends 12-week history to Claude and asks: "given what
   actually happened, are the stage definitions and thresholds still right?
   What should change?" Writes Claude's output back to config.

Runs 1st of each month at 08:00 UTC. Sends a Telegram summary of what changed.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone

