    except (OSError, json.JSONDecodeError):
        return dict(_DEFAULT_CONFIG)


def _read_yaml_field(key):
    try:
        with open(H2_CONFIG) as f:
            for line in f:
                if key in line:
                    return line.split(":", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


from telegram_env import h2_send_telegram, html_esc


# Tags Telegram accepts. Everything else in the model's output is prose and
# must be escaped, not sent as markup.
_ALLOWED_TAGS = ("b", "i", "u", "s", "code", "pre")


def sanitize_html(msg):
    """
    Make model output safe for Telegram's HTML parser.

    This is why the report went missing for weeks. Telegram rejects the whole
    message on any tag it does not know, and a model writing Norwegian prose
    produces them constantly: "CTR < 1 %" reads as an unknown tag, and so does
    any stray angle bracket. The send then failed, fell through to an h2
    fallback that was also broken, and nothing arrived — no error anyone saw.
    """
    msg = msg.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    for tag in _ALLOWED_TAGS:
        msg = msg.replace(f"&lt;{tag}&gt;", f"<{tag}>").replace(f"&lt;/{tag}&gt;", f"</{tag}>")
    return msg


def tg_send(msg):
    # sanitize_html first: model output (and error strings) can contain stray
    # < that would 400 Telegram's HTML parser. The bridge then delivers.
    try:
        h2_send_telegram(sanitize_html(msg))
    except Exception as e:
        print(f"telegram send failed: {e}", flush=True)


def cf_token():
    with open(SECRETS) as f:
        for line in f:
            line = line.strip()
            if line.startswith("export "):
                line = line[7:]
            if line.startswith("CLOUDFLARE_API_TOKEN="):
                return line.split("=", 1)[1].strip().strip('"')
    raise RuntimeError("no CLOUDFLARE_API_TOKEN in " + SECRETS)


def d1(token, sql):
    req = urllib.request.Request(
        f"https://api.cloudflare.com/client/v4/accounts/{ACCT}/d1/database/{DBID}/query",
        data=json.dumps({"sql": sql}).encode(),
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)["result"][0]["results"]


def web_pageviews(token, start, end):
    try:
        q = (
            'query{viewer{accounts(filter:{accountTag:"%s"}){'
            'pv:rumPageloadEventsAdaptiveGroups(limit:1,filter:{siteTag:"%s",'
            'date_geq:"%s",date_leq:"%s"}){count}}}}' % (ACCT, SITE, start, end)
        )
        req = urllib.request.Request(
            "https://api.cloudflare.com/client/v4/graphql",
            data=json.dumps({"query": q}).encode(),
            headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=30) as r:
            d = json.load(r)
        return d["data"]["viewer"]["accounts"][0]["pv"][0]["count"]
    except Exception:
        return 0


def load_history():
    try:
        return json.loads(open(STATE_FILE).read())
    except (OSError, json.JSONDecodeError):
        return []


def save_history(history):
    open(STATE_FILE, "w").write(json.dumps(history, indent=2))


def delta(now, prev, key):
    if prev is None:
        return None
    return now.get(key, 0) - prev.get(key, 0)


def pct_change(now_val, prev_val):
    if prev_val is None or prev_val == 0:
        return None
    return round((now_val - prev_val) / prev_val * 100)


def fmt_delta(d, unit=""):
    if d is None:
        return "ny"
    sign = "+" if d > 0 else ""
    return f"{sign}{d}{unit}"


def build_bot_filter(patterns):
    """Build SQL WHERE clause from config bot UA patterns."""
    clauses = " AND ".join(f"ua NOT LIKE '%{p}%'" for p in patterns)
    return f"({clauses} AND ua IS NOT NULL AND ua != '')"


